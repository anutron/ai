{
  "$schema": "scope-presets",
  "presets": {
    "full": {
      "description": "Everything not matched by the source's hardcoded exclude list.",
      "skills": "*",
      "snippets": "*",
      "excludeSkills": ["airon-*", "personal-only", "anutron-install", "anutron-uninstall"]
    },
    "spec-discipline": {
      "description": "Spec-first + TDD + quality gates.",
      "skillTags": ["spec", "quality"],
      "snippetTags": ["spec", "quality", "formatting"],
      "snippetAudience": ["shared"]
    },
    "dev-tools": {
      "extends": "spec-discipline",
      "description": "spec-discipline + parallel workflow + PR shipping.",
      "skillTags": ["spec", "quality", "workflow", "pr"]
    },
    "custom": {
      "description": "Read from .anutron-install.config.json in the target repo.",
      "from": "manifest"
    }
  }
}
